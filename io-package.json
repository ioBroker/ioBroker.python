{
    "common": {
        "name": "python",
        "version": "0.0.2",
        "title": "Python",
        "titleLang": {
            "en": "Python",
            "de": "Python",
            "ru": "Python"
        },
        "desc": {
            "en": "Write ioBroker logic scripts in Python",
            "de": "ioBroker-Logikskripte in Python schreiben",
            "ru": "Скрипты логики ioBroker на Python"
        },
        "authors": ["bluefox <dogafox@gmail.com>"],
        "keywords": ["python", "script", "logic", "automation"],
        "platform": "Python",
        "main": "python/iobpython/__main__.py",
        "mode": "daemon",
        "tier": 1,
        "type": "logic",
        "enabled": true,
        "messagebox": true,
        "connectionType": "local",
        "dataSource": "push",
        "icon": "python.svg",
        "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.python/main/admin/python.svg",
        "adminUI": {
            "config": "json",
            "tab": "html"
        },
        "adminTab": {
            "name": {
                "en": "Automation Python scripts",
                "de": "Python-Skripte",
                "ru": "Скрипты Python"
            },
            "singleton": true
        },
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "news": {
            "0.0.2": {
                "en": "Added prettier",
                "de": "Prettier hinzugefügt"
            },
            "0.0.1": {
                "en": "Prototype: runs Python logic scripts",
                "de": "Prototyp: führt Python-Logikskripte aus",
                "ru": "Прототип: выполняет скрипты логики на Python"
            }
        },
        "dependencies": [
            {
                "js-controller": ">7.2.2",
                "py-controller": ">=0.0.1"
            }
        ]
    },
    "native": {
        "blockedWarnSeconds": 2,
        "maxLogLines": 300,
        "userPackages": []
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Connected to the databases",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "scriptsRunning",
            "type": "state",
            "common": {
                "role": "value",
                "name": "Number of running scripts",
                "type": "number",
                "read": true,
                "write": false,
                "def": 0
            },
            "native": {}
        }
    ]
}
