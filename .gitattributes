# Everything text is stored and checked out with LF, whatever the platform.
# Without this a tool run on Windows can rewrite a whole file to CRLF, which turns a
# twenty-line edit into a two-hundred-line diff and ruins `git blame` for that file.
* text=auto eol=lf

# Built bundles: keep them out of diffs, they are generated by `npm run build`.
admin/assets/** -diff linguist-generated
