{
    "name": "iobroker.python",
    "version": "0.0.1",
    "description": "Write ioBroker logic scripts in Python",
    "author": "bluefox <dogafox@gmail.com>",
    "license": "MIT",
    "main": "python/iobpython/__main__.py",
    "keywords": [
        "ioBroker",
        "python",
        "logic",
        "script",
        "automation"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.python"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "install-admin": "npm --prefix src-admin ci",
        "build": "npm --prefix src-admin run build",
        "start-admin": "npm --prefix src-admin run start",
        "test:package": "mocha test/package --exit --config test/mocharc.custom.json",
        "test:python": "pytest -q",
        "test": "npm run test:package"
    },
    "files": [
        "io-package.json",
        "pyproject.toml",
        "python/",
        "admin/",
        "LICENSE",
        "README.md"
    ],
    "devDependencies": {
        "@iobroker/testing": "^5.3.0",
        "mocha": "^12.0.0"
    }
}
